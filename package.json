{
    "name": "store-galore",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "test": "vitest run",
        "cf-typegen": "wrangler types --env-interface=CloudflareBindings",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix"
    },
    "dependencies": {
        "discord-interactions": "^4.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "hono": "^4.13.13"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.0.0",
        "@cloudflare/workers-types": "^5.20261019.1",
        "@types/node": "^26.6.5",
        "drizzle-kit": "1.0.0-rc.4",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "typescript": "^5.5.2",
        "vitest": "~4.1.0",
        "wrangler": "^4.151.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": "26.12.0",
            "onFail": "error"
        }
    }
}
